<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Summit Roofing — Repair &amp; Replacement</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{background:#14100c;color:#f2ede6;font-family:'Inter',sans-serif;overflow-x:hidden;}
  .mono{font-family:'IBM Plex Mono',monospace;}
  a{color:inherit;}

  header{position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;padding:20px 6vw;background:rgba(20,16,12,0.9);backdrop-filter:blur(10px);border-bottom:1px solid rgba(178,102,58,0.2);}
  .brand{font-family:'Oswald',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:0.03em;font-size:1.1rem;display:flex;align-items:center;gap:10px;}
  .brand .mark{width:28px;height:28px;background:#b2663a;clip-path:polygon(50% 0,100% 100%,0 100%);display:flex;align-items:center;justify-content:center;}
  nav a{margin-left:26px;text-decoration:none;font-size:0.85rem;color:#b3a89b;}
  nav a:hover{color:#b2663a;}

  .hero{padding:80px 6vw 60px;max-width:1200px;margin:0 auto;}
  .eyebrow{font-family:'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:0.14em;color:#c97d47;font-size:0.72rem;}
  .hero h1{font-family:'Oswald',sans-serif;font-weight:600;text-transform:uppercase;font-size:clamp(2rem,4.2vw,3.3rem);line-height:1.08;margin:16px 0 18px;max-width:760px;}
  .hero h1 span{color:#c97d47;}
  .hero p{color:#b3a89b;font-size:1.02rem;line-height:1.65;max-width:560px;margin-bottom:28px;}
  .hero-ctas{display:flex;gap:14px;flex-wrap:wrap;}
  .btn-primary{background:#c97d47;color:#14100c;border:none;padding:14px 26px;font-weight:700;font-size:0.88rem;cursor:pointer;text-decoration:none;display:inline-block;font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:0.02em;}
  .btn-ghost{border:1px solid rgba(178,102,58,0.4);color:#f2ede6;padding:14px 26px;font-size:0.88rem;text-decoration:none;display:inline-block;font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:0.02em;}

  .roof-visual{margin-top:40px;height:200px;position:relative;background:linear-gradient(160deg,#2a1c10,#14100c 70%);border-radius:14px;border:1px solid rgba(178,102,58,0.2);overflow:hidden;}
  .shingle-row{position:absolute;left:0;right:0;height:22px;background:repeating-linear-gradient(90deg,#3d2a18 0 40px,#2a1c10 40px 44px);}

  .stat-strip{display:flex;gap:40px;flex-wrap:wrap;padding:30px 6vw;border-top:1px solid rgba(178,102,58,0.15);border-bottom:1px solid rgba(178,102,58,0.15);}
  .stat-strip div{font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:#b3a89b;}
  .stat-strip strong{display:block;color:#c97d47;font-size:1.5rem;font-family:'Oswald',sans-serif;font-weight:600;}

  .calc-section{padding:90px 6vw;max-width:1000px;margin:0 auto;}
  .section-head{max-width:600px;margin:0 auto 44px;text-align:center;}
  .section-head h2{font-family:'Oswald',sans-serif;text-transform:uppercase;font-weight:600;font-size:clamp(1.7rem,3vw,2.3rem);margin:14px 0 12px;}
  .section-head p{color:#b3a89b;line-height:1.6;}
  .calc-box{background:#1c160f;border:1px solid rgba(178,102,58,0.2);border-radius:10px;padding:40px;display:grid;grid-template-columns:1fr 1fr;gap:36px;}
  .calc-field{margin-bottom:20px;}
  .calc-field label{display:block;font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:#b3a89b;margin-bottom:10px;text-transform:uppercase;letter-spacing:0.05em;}
  input[type=range]{width:100%;accent-color:#c97d47;}
  .val{font-family:'IBM Plex Mono',monospace;color:#c97d47;font-size:0.95rem;margin-top:6px;}
  .opt-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .opt-btn{padding:12px;border-radius:6px;border:1px solid rgba(178,102,58,0.3);background:transparent;color:#f2ede6;font-family:'Inter',sans-serif;font-size:0.85rem;cursor:pointer;}
  .opt-btn.active{background:#c97d47;color:#14100c;font-weight:600;border-color:#c97d47;}
  .calc-result{background:linear-gradient(160deg,rgba(201,125,71,0.12),rgba(201,125,71,0.02));border:1px solid rgba(178,102,58,0.3);border-radius:8px;padding:26px;display:flex;flex-direction:column;justify-content:center;}
  .calc-result .row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px dashed rgba(178,102,58,0.2);font-size:0.9rem;}
  .calc-result .row:last-child{border-bottom:none;}
  .calc-result .row .amount{font-family:'IBM Plex Mono',monospace;color:#c97d47;font-weight:600;}
  .calc-cta{margin-top:18px;display:block;text-align:center;background:#c97d47;color:#14100c;font-weight:700;padding:14px;border-radius:6px;text-decoration:none;font-size:0.9rem;}
  @media(max-width:760px){.calc-box{grid-template-columns:1fr;}}

  .services-section{padding:20px 6vw 100px;max-width:1200px;margin:0 auto;}
  .services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:36px;}
  .service-card{background:#1c160f;border:1px solid rgba(178,102,58,0.15);border-radius:8px;padding:28px;}
  .service-card h3{font-family:'Oswald',sans-serif;font-weight:600;text-transform:uppercase;font-size:1.05rem;margin-bottom:8px;}
  .service-card p{color:#b3a89b;font-size:0.9rem;line-height:1.55;}
  @media(max-width:760px){.services-grid{grid-template-columns:1fr;}}

  footer{padding:50px 6vw;text-align:center;border-top:1px solid rgba(178,102,58,0.15);}
  footer p{color:#b3a89b;font-family:'IBM Plex Mono',monospace;font-size:0.78rem;}

  .wa-float{position:fixed;bottom:24px;right:24px;z-index:50;background:#25D366;color:#fff;width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;text-decoration:none;box-shadow:0 8px 24px rgba(37,211,102,0.4);}
</style>
</head>
<body style="background:#14100c;color:#f2ede6;">

<header>
  <div class="brand"><div class="mark"></div>Summit Roofing</div>
  <nav><a href="#quote">Get a Quote</a><a href="#services">Services</a></nav>
</header>

<section class="hero">
  <div class="eyebrow">// ROOF REPAIR &amp; REPLACEMENT</div>
  <h1>A roof that <span>outlasts the storm</span> before it hits.</h1>
  <p>Licensed roofers handling leak repairs, full replacements, and storm damage assessments — with a 10-year workmanship warranty on every job.</p>
  <div class="hero-ctas">
    <a href="#quote" class="btn-primary">Get a Free Estimate</a>
    <a href="#services" class="btn-ghost">View Services</a>
  </div>
  <div class="roof-visual">
    <div class="shingle-row" style="top:20px;"></div>
    <div class="shingle-row" style="top:60px;"></div>
    <div class="shingle-row" style="top:100px;"></div>
    <div class="shingle-row" style="top:140px;"></div>
  </div>
</section>

<div class="stat-strip">
  <div><strong>900+</strong>ROOFS COMPLETED</div>
  <div><strong>10YR</strong>WORKMANSHIP WARRANTY</div>
  <div><strong>24HR</strong>STORM RESPONSE</div>
  <div><strong>4.9*</strong>AVERAGE RATING</div>
</div>

<section class="calc-section" id="quote">
  <div class="section-head">
    <div class="eyebrow">// INSTANT ESTIMATE</div>
    <h2>Calculate My Roofing Quote</h2>
    <p>Move the slider to your roof size and pick a material — get a rough price range instantly.</p>
  </div>
  <div class="calc-box">
    <div>
      <div class="calc-field">
        <label>Roof Size</label>
        <input type="range" id="sizeRange" min="60" max="400" step="10" value="150">
        <div class="val" id="sizeVal">150 m²</div>
      </div>
      <div class="calc-field">
        <label>Material</label>
        <div class="opt-grid">
          <button class="opt-btn active" data-rate="450" id="matTile">Concrete Tile</button>
          <button class="opt-btn" data-rate="380" id="matSheet">IBR Sheeting</button>
          <button class="opt-btn" data-rate="620" id="matSlate">Slate</button>
          <button class="opt-btn" data-rate="290" id="matRepair">Repair Only</button>
        </div>
      </div>
    </div>
    <div class="calc-result">
      <div class="row"><span>Estimated Cost</span><span class="amount" id="outPrice">R67,500 - R81,000</span></div>
      <div class="row"><span>Estimated Duration</span><span class="amount" id="outTime">3 - 5 days</span></div>
      <div class="row"><span>Warranty</span><span class="amount">10 Years</span></div>
      <a href="https://wa.me/27727367095?text=Hi%2C%20I%27d%20like%20a%20roofing%20quote" class="calc-cta" target="_blank" rel="noopener">Send This Estimate on WhatsApp →</a>
    </div>
  </div>
</section>

<section class="services-section" id="services">
  <div class="section-head" style="margin-bottom:0;">
    <div class="eyebrow">// WHAT WE DO</div>
    <h2>Every roof, built to last</h2>
  </div>
  <div class="services-grid">
    <div class="service-card"><h3>Leak Repair</h3><p>Fast, permanent fixes for leaks — not just a patch until next winter.</p></div>
    <div class="service-card"><h3>Full Replacement</h3><p>Complete tear-off and re-roof, with material options for every budget.</p></div>
    <div class="service-card"><h3>Storm Damage</h3><p>Insurance-ready assessments and repairs after hail or wind damage.</p></div>
  </div>
</section>

<footer><p>SUMMIT ROOFING — Roof repair and replacement, backed by a 10-year warranty.</p></footer>

<a href="https://wa.me/27727367095?text=Hi%2C%20I%27d%20like%20to%20chat%20about%20roofing" class="wa-float" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <svg viewBox="0 0 24 24" width="30" height="30" fill="white"><path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7C17.18 3.03 14.68 2 12.04 2zm5.8 14.16c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.8-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.79-4.16-4.94-4.35-.14-.2-1.18-1.57-1.18-3 0-1.42.75-2.12 1.01-2.41.27-.29.58-.36.78-.36l.56.01c.18 0 .42-.07.65.5.24.58.82 2 .89 2.15.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.17-.3.37-.43.5-.14.14-.29.29-.13.57.17.28.75 1.24 1.61 2 1.11.99 2.04 1.3 2.32 1.44.28.14.45.12.61-.07.17-.19.72-.84.91-1.13.19-.28.38-.24.64-.14.26.1 1.66.78 1.94.93.28.14.47.21.54.33.07.12.07.68-.17 1.36z"/></svg>
</a>

<script>
  let rate = 450;
  const sizeRange = document.getElementById('sizeRange');
  const sizeVal = document.getElementById('sizeVal');
  const outPrice = document.getElementById('outPrice');
  const outTime = document.getElementById('outTime');
  const matButtons = document.querySelectorAll('[data-rate]');
  function fmt(n){ return 'R' + Math.round(n).toLocaleString('en-ZA'); }
  function update(){
    const size = parseInt(sizeRange.value, 10);
    sizeVal.textContent = size + ' m²';
    const low = size * rate;
    const high = low * 1.2;
    outPrice.textContent = fmt(low) + ' - ' + fmt(high);
    outTime.textContent = size < 150 ? '2 - 3 days' : size < 300 ? '3 - 5 days' : '5 - 8 days';
  }
  sizeRange.addEventListener('input', update);
  matButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      matButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      rate = parseFloat(btn.dataset.rate);
      update();
    });
  });
  update();
</script>

</body>
</html>

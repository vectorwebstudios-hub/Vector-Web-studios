<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Apex HVAC — Heating & Cooling Repair</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{background:#0f0d0a;color:#f5efe6;font-family:'Space Grotesk',sans-serif;overflow-x:hidden;}
  .mono{font-family:'IBM Plex Mono',monospace;}
  a{color:inherit;}

  header{position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;padding:20px 6vw;background:rgba(15,13,10,0.9);backdrop-filter:blur(10px);border-bottom:1px solid rgba(255,122,48,0.18);}
  .brand{font-weight:700;font-size:1.1rem;display:flex;align-items:center;gap:10px;}
  .brand .mark{width:28px;height:28px;background:#ff7a30;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#0f0d0a;font-weight:800;}
  nav a{margin-left:26px;text-decoration:none;font-size:0.85rem;color:#b8ada0;}
  nav a:hover{color:#ff7a30;}

  .hero{padding:80px 6vw 60px;max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1.1fr 0.9fr;gap:50px;align-items:center;}
  .eyebrow{font-family:'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:0.16em;color:#ff7a30;font-size:0.72rem;}
  .hero h1{font-size:clamp(2.1rem,4.4vw,3.4rem);line-height:1.08;font-weight:700;margin:16px 0 18px;}
  .hero h1 span{color:#ff7a30;}
  .hero p{color:#b8ada0;font-size:1.02rem;line-height:1.65;max-width:480px;margin-bottom:26px;}
  .badges{display:flex;gap:12px;flex-wrap:wrap;}
  .badge{display:flex;align-items:center;gap:8px;border:1px solid rgba(255,122,48,0.35);background:rgba(255,122,48,0.06);padding:9px 14px;border-radius:100px;font-family:'IBM Plex Mono',monospace;font-size:0.72rem;color:#ff7a30;}

  .hero-visual{position:relative;aspect-ratio:1/1;border-radius:16px;overflow:hidden;background:radial-gradient(circle at 30% 20%,#3a1f08,#0f0d0a 70%);border:1px solid rgba(255,122,48,0.2);display:flex;align-items:center;justify-content:center;}
  .dial{width:180px;height:180px;border-radius:50%;border:10px solid #2a1c10;position:relative;display:flex;align-items:center;justify-content:center;}
  .dial::after{content:"22°C";font-family:'IBM Plex Mono',monospace;font-size:1.4rem;color:#ff7a30;font-weight:600;}
  .dial::before{content:"";position:absolute;top:-10px;left:50%;width:4px;height:24px;background:#ff7a30;transform:translateX(-50%);border-radius:2px;}

  .trust-strip{display:flex;gap:40px;flex-wrap:wrap;justify-content:center;padding:30px 6vw;border-top:1px solid rgba(255,122,48,0.12);border-bottom:1px solid rgba(255,122,48,0.12);font-family:'IBM Plex Mono',monospace;font-size:0.78rem;color:#b8ada0;text-align:center;}
  .trust-strip strong{color:#f5efe6;display:block;font-size:1.4rem;font-family:'Space Grotesk',sans-serif;font-weight:700;}

  .calc-section{padding:90px 6vw;max-width:1000px;margin:0 auto;}
  .section-head{max-width:600px;margin:0 auto 44px;text-align:center;}
  .section-head h2{font-size:clamp(1.7rem,3vw,2.3rem);font-weight:700;margin:14px 0 12px;}
  .section-head p{color:#b8ada0;line-height:1.6;}
  .calc-box{background:#181410;border:1px solid rgba(255,122,48,0.2);border-radius:14px;padding:40px;display:grid;grid-template-columns:1fr 1fr;gap:36px;}
  .calc-field{margin-bottom:20px;}
  .calc-field label{display:block;font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:#b8ada0;margin-bottom:10px;text-transform:uppercase;letter-spacing:0.05em;}
  .opt-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .opt-btn{padding:12px;border-radius:8px;border:1px solid rgba(255,122,48,0.3);background:transparent;color:#f5efe6;font-family:'Space Grotesk',sans-serif;font-size:0.85rem;cursor:pointer;}
  .opt-btn.active{background:#ff7a30;color:#0f0d0a;font-weight:600;border-color:#ff7a30;}
  .calc-result{background:linear-gradient(160deg,rgba(255,122,48,0.12),rgba(255,122,48,0.02));border:1px solid rgba(255,122,48,0.3);border-radius:10px;padding:26px;display:flex;flex-direction:column;justify-content:center;}
  .calc-result .row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px dashed rgba(255,122,48,0.2);font-size:0.9rem;}
  .calc-result .row:last-child{border-bottom:none;}
  .calc-result .row .amount{font-family:'IBM Plex Mono',monospace;color:#ff7a30;font-weight:600;}
  .calc-cta{margin-top:18px;display:block;text-align:center;background:#ff7a30;color:#0f0d0a;font-weight:700;padding:14px;border-radius:8px;text-decoration:none;font-size:0.9rem;}
  @media(max-width:760px){.calc-box{grid-template-columns:1fr;}.hero{grid-template-columns:1fr;}}

  .services-section{padding:20px 6vw 100px;max-width:1200px;margin:0 auto;}
  .services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:36px;}
  .service-card{background:#181410;border:1px solid rgba(255,122,48,0.15);border-radius:10px;padding:28px;}
  .service-card .icon{width:38px;height:38px;border-radius:8px;background:rgba(255,122,48,0.12);display:flex;align-items:center;justify-content:center;margin-bottom:16px;color:#ff7a30;font-weight:700;}
  .service-card h3{font-size:1.05rem;margin-bottom:8px;}
  .service-card p{color:#b8ada0;font-size:0.9rem;line-height:1.55;}
  @media(max-width:760px){.services-grid{grid-template-columns:1fr;}}

  footer{padding:60px 6vw;text-align:center;border-top:1px solid rgba(255,122,48,0.15);}
  footer p{color:#b8ada0;font-family:'IBM Plex Mono',monospace;font-size:0.8rem;}

  .wa-float{position:fixed;bottom:24px;right:24px;z-index:50;background:#25D366;color:#fff;width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;text-decoration:none;box-shadow:0 8px 24px rgba(37,211,102,0.4);}
</style>
</head>
<body style="background:#0f0d0a;color:#f5efe6;">

<header>
  <div class="brand"><div class="mark">A</div>Apex HVAC</div>
  <nav><a href="#quote">Get a Quote</a><a href="#services">Services</a></nav>
</header>

<section class="hero">
  <div>
    <div class="eyebrow">// HEATING &amp; COOLING REPAIR</div>
    <h1>Too hot, too cold, <span>fixed today.</span></h1>
    <p>Licensed technicians repairing and installing heating and cooling systems across the metro. Same-day callouts, upfront pricing, no surprise fees.</p>
    <div class="badges">
      <div class="badge">LICENSED TECHNICIANS</div>
      <div class="badge">SAME-DAY CALLOUTS</div>
      <div class="badge">1-YEAR REPAIR WARRANTY</div>
    </div>
  </div>
  <div class="hero-visual"><div class="dial"></div></div>
</section>

<div class="trust-strip">
  <div><strong>1,200+</strong>REPAIRS COMPLETED</div>
  <div><strong>45min</strong>AVERAGE RESPONSE</div>
  <div><strong>24/7</strong>EMERGENCY LINE</div>
  <div><strong>4.8*</strong>AVERAGE RATING</div>
</div>

<section class="calc-section" id="quote">
  <div class="section-head">
    <div class="eyebrow">// INSTANT ESTIMATE</div>
    <h2>Calculate My Callout Cost</h2>
    <p>Pick your system type and issue — get a rough price range instantly.</p>
  </div>
  <div class="calc-box">
    <div>
      <div class="calc-field">
        <label>System Type</label>
        <div class="opt-grid">
          <button class="opt-btn active" data-base="850" data-sys="split">Split AC Unit</button>
          <button class="opt-btn" data-base="1400" data-sys="ducted">Ducted System</button>
          <button class="opt-btn" data-base="950" data-sys="heatpump">Heat Pump</button>
          <button class="opt-btn" data-base="600" data-sys="furnace">Furnace</button>
        </div>
      </div>
      <div class="calc-field">
        <label>Issue Type</label>
        <div class="opt-grid">
          <button class="opt-btn active" data-mult="1" id="issueDiag">Diagnostic Only</button>
          <button class="opt-btn" data-mult="1.9" id="issueRepair">Repair Needed</button>
        </div>
      </div>
    </div>
    <div class="calc-result">
      <div class="row"><span>Estimated Callout Cost</span><span class="amount" id="outPrice">R850 – R1,020</span></div>
      <div class="row"><span>Response Window</span><span class="amount">Same day</span></div>
      <div class="row"><span>Warranty</span><span class="amount">1 Year</span></div>
      <a href="https://wa.me/27727367095?text=Hi%2C%20I%27d%20like%20a%20HVAC%20callout" class="calc-cta" target="_blank" rel="noopener">Book This Callout on WhatsApp →</a>
    </div>
  </div>
</section>

<section class="services-section" id="services">
  <div class="section-head" style="margin-bottom:0;">
    <div class="eyebrow">// WHAT WE DO</div>
    <h2>Every system, every season</h2>
  </div>
  <div class="services-grid">
    <div class="service-card"><div class="icon">AC</div><h3>Air Conditioning</h3><p>Repairs, servicing, and new installs for split and ducted systems.</p></div>
    <div class="service-card"><div class="icon">HP</div><h3>Heat Pumps</h3><p>Efficient heating and cooling in one system, installed and maintained.</p></div>
    <div class="service-card"><div class="icon">FR</div><h3>Furnace Service</h3><p>Annual servicing and emergency furnace repairs before winter hits.</p></div>
  </div>
</section>

<footer><p>APEX HVAC — Heating and cooling repair, done right the first time.</p></footer>

<a href="https://wa.me/27727367095?text=Hi%2C%20I%27d%20like%20to%20chat%20about%20HVAC%20repair" class="wa-float" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <svg viewBox="0 0 24 24" width="30" height="30" fill="white"><path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7C17.18 3.03 14.68 2 12.04 2zm5.8 14.16c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.8-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.79-4.16-4.94-4.35-.14-.2-1.18-1.57-1.18-3 0-1.42.75-2.12 1.01-2.41.27-.29.58-.36.78-.36l.56.01c.18 0 .42-.07.65.5.24.58.82 2 .89 2.15.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.17-.3.37-.43.5-.14.14-.29.29-.13.57.17.28.75 1.24 1.61 2 1.11.99 2.04 1.3 2.32 1.44.28.14.45.12.61-.07.17-.19.72-.84.91-1.13.19-.28.38-.24.64-.14.26.1 1.66.78 1.94.93.28.14.47.21.54.33.07.12.07.68-.17 1.36z"/></svg>
</a>

<script>
  let base = 850, mult = 1;
  const sysButtons = document.querySelectorAll('[data-sys]');
  const issueButtons = document.querySelectorAll('[data-mult]');
  const outPrice = document.getElementById('outPrice');
  function fmt(n){ return 'R' + Math.round(n).toLocaleString('en-ZA'); }
  function update(){
    const low = base * mult;
    const high = low * 1.2;
    outPrice.textContent = fmt(low) + ' - ' + fmt(high);
  }
  sysButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      sysButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      base = parseFloat(btn.dataset.base);
      update();
    });
  });
  issueButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      issueButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      mult = parseFloat(btn.dataset.mult);
      update();
    });
  });
  update();
</script>

</body>
</html>

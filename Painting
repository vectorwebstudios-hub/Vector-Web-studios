<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bright Line Painting — Residential &amp; Commercial</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{background:#f5f7fa;color:#1b2430;font-family:'Inter',sans-serif;overflow-x:hidden;}
  .mono{font-family:'IBM Plex Mono',monospace;}
  a{color:inherit;}

  header{position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;padding:20px 6vw;background:rgba(245,247,250,0.9);backdrop-filter:blur(10px);border-bottom:1px solid rgba(74,127,255,0.15);}
  .brand{font-family:'Fraunces',serif;font-weight:600;font-size:1.2rem;display:flex;align-items:center;gap:10px;}
  .brand .mark{width:30px;height:30px;border-radius:50%;background:#4a7fff;color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.85rem;font-family:'Fraunces',serif;}
  nav a{margin-left:24px;text-decoration:none;font-size:0.85rem;color:#5a6472;}
  nav a:hover{color:#4a7fff;}

  .hero{padding:80px 6vw 60px;max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1.1fr 0.9fr;gap:50px;align-items:center;}
  .eyebrow{font-family:'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:0.14em;color:#4a7fff;font-size:0.7rem;font-weight:600;}
  .hero h1{font-family:'Fraunces',serif;font-weight:600;font-size:clamp(2rem,4vw,3.1rem);line-height:1.12;margin:16px 0 18px;color:#1b2430;}
  .hero p{color:#5a6472;font-size:1.02rem;line-height:1.65;max-width:460px;margin-bottom:28px;}
  .hero-ctas{display:flex;gap:14px;flex-wrap:wrap;}
  .btn-primary{background:#4a7fff;color:#fff;border:none;padding:14px 26px;border-radius:6px;font-weight:600;font-size:0.9rem;cursor:pointer;}
  .btn-ghost{background:transparent;border:1px solid rgba(74,127,255,0.35);color:#1b2430;padding:14px 26px;border-radius:6px;font-weight:600;font-size:0.9rem;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;}

  .hero-visual{aspect-ratio:1/1;border-radius:16px;background:linear-gradient(160deg,#4a7fff,#2456d6);position:relative;overflow:hidden;border:1px solid rgba(74,127,255,0.2);}
  .paint-stripe{position:absolute;height:24px;left:-10%;width:120%;background:rgba(255,255,255,0.15);transform:rotate(-8deg);}

  .trust-strip{display:flex;gap:40px;flex-wrap:wrap;justify-content:center;padding:30px 6vw;border-top:1px solid rgba(74,127,255,0.12);border-bottom:1px solid rgba(74,127,255,0.12);font-family:'IBM Plex Mono',monospace;font-size:0.78rem;color:#5a6472;text-align:center;}
  .trust-strip strong{color:#1b2430;display:block;font-size:1.4rem;font-family:'Fraunces',serif;font-weight:600;}

  .calc-section{padding:90px 6vw;max-width:1000px;margin:0 auto;}
  .section-head{max-width:600px;margin:0 auto 44px;text-align:center;}
  .section-head h2{font-family:'Fraunces',serif;font-size:clamp(1.7rem,3vw,2.3rem);font-weight:600;margin:14px 0 12px;color:#1b2430;}
  .section-head p{color:#5a6472;line-height:1.6;}
  .calc-box{background:#fff;border:1px solid rgba(74,127,255,0.18);border-radius:14px;padding:40px;display:grid;grid-template-columns:1fr 1fr;gap:36px;box-shadow:0 4px 20px rgba(27,36,48,0.05);}
  .calc-field{margin-bottom:20px;}
  .calc-field label{display:block;font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:#5a6472;margin-bottom:10px;text-transform:uppercase;letter-spacing:0.05em;}
  .opt-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .opt-btn{padding:12px;border-radius:6px;border:1px solid rgba(74,127,255,0.3);background:transparent;color:#1b2430;font-family:'Inter',sans-serif;font-size:0.85rem;cursor:pointer;}
  .opt-btn.active{background:#4a7fff;color:#fff;font-weight:600;border-color:#4a7fff;}
  .calc-result{background:linear-gradient(160deg,rgba(74,127,255,0.08),rgba(74,127,255,0.02));border:1px solid rgba(74,127,255,0.25);border-radius:10px;padding:26px;display:flex;flex-direction:column;justify-content:center;}
  .calc-result .row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px dashed rgba(74,127,255,0.2);font-size:0.9rem;}
  .calc-result .row:last-child{border-bottom:none;}
  .calc-result .row .amount{font-family:'IBM Plex Mono',monospace;color:#2456d6;font-weight:600;}
  .calc-cta{margin-top:18px;display:block;text-align:center;background:#4a7fff;color:#fff;font-weight:700;padding:14px;border-radius:6px;text-decoration:none;font-size:0.9rem;}
  @media(max-width:760px){.calc-box{grid-template-columns:1fr;}.hero{grid-template-columns:1fr;}}

  .services-section{padding:20px 6vw 100px;max-width:1200px;margin:0 auto;}
  .services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:36px;}
  .service-card{background:#fff;border:1px solid rgba(74,127,255,0.14);border-radius:10px;padding:28px;box-shadow:0 2px 10px rgba(27,36,48,0.04);}
  .service-card h3{font-family:'Fraunces',serif;font-weight:600;font-size:1.1rem;margin-bottom:8px;color:#1b2430;}
  .service-card p{color:#5a6472;font-size:0.9rem;line-height:1.55;}
  @media(max-width:760px){.services-grid{grid-template-columns:1fr;}}

  footer{padding:50px 6vw;text-align:center;border-top:1px solid rgba(74,127,255,0.15);}
  footer p{color:#5a6472;font-family:'IBM Plex Mono',monospace;font-size:0.78rem;}

  .wa-float{position:fixed;bottom:24px;right:24px;z-index:50;background:#25D366;color:#fff;width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;text-decoration:none;box-shadow:0 8px 24px rgba(37,211,102,0.4);}
</style>
</head>
<body style="background:#f5f7fa;color:#1b2430;">

<header>
  <div class="brand"><div class="mark">B</div>Bright Line Painting</div>
  <nav><a href="#quote">Get a Quote</a><a href="#services">Services</a></nav>
</header>

<section class="hero">
  <div>
    <div class="eyebrow">// RESIDENTIAL &amp; COMMERCIAL PAINTING</div>
    <h1>Clean lines, no drips, done on schedule.</h1>
    <p>Interior and exterior painting for homes and businesses — prepped properly, finished neatly, with a 2-year finish warranty on every job.</p>
    <div class="hero-ctas">
      <button class="btn-primary" onclick="document.getElementById('quote').scrollIntoView({behavior:'smooth'})">Get a Free Quote</button>
      <a href="#services" class="btn-ghost">View Services</a>
    </div>
  </div>
  <div class="hero-visual">
    <div class="paint-stripe" style="top:30%;"></div>
    <div class="paint-stripe" style="top:55%;"></div>
    <div class="paint-stripe" style="top:80%;"></div>
  </div>
</section>

<div class="trust-strip">
  <div><strong>640+</strong>PROJECTS COMPLETED</div>
  <div><strong>2YR</strong>FINISH WARRANTY</div>
  <div><strong>ON-TIME</strong>SCHEDULING</div>
  <div><strong>4.9*</strong>AVERAGE RATING</div>
</div>

<section class="calc-section" id="quote">
  <div class="section-head">
    <div class="eyebrow">// INSTANT ESTIMATE</div>
    <h2>Calculate My Painting Quote</h2>
    <p>Move the slider to your room count and pick interior or exterior — get a rough price range instantly.</p>
  </div>
  <div class="calc-box">
    <div>
      <div class="calc-field">
        <label>Number of Rooms / Areas</label>
        <input type="range" id="roomRange" min="1" max="12" step="1" value="4" style="width:100%;accent-color:#4a7fff;">
        <div class="mono" id="roomVal" style="color:#2456d6;margin-top:6px;">4 rooms</div>
      </div>
      <div class="calc-field">
        <label>Job Type</label>
        <div class="opt-grid">
          <button class="opt-btn active" data-rate="2200" id="jobInterior">Interior</button>
          <button class="opt-btn" data-rate="3100" id="jobExterior">Exterior</button>
        </div>
      </div>
    </div>
    <div class="calc-result">
      <div class="row"><span>Estimated Cost</span><span class="amount" id="outPrice">R8,800 - R10,560</span></div>
      <div class="row"><span>Estimated Duration</span><span class="amount" id="outTime">2 - 3 days</span></div>
      <div class="row"><span>Warranty</span><span class="amount">2 Years</span></div>
      <a href="https://wa.me/27727367095?text=Hi%2C%20I%27d%20like%20a%20painting%20quote" class="calc-cta" target="_blank" rel="noopener">Send This Estimate on WhatsApp →</a>
    </div>
  </div>
</section>

<section class="services-section" id="services">
  <div class="section-head" style="margin-bottom:0;">
    <div class="eyebrow">// WHAT WE DO</div>
    <h2>Every surface, every finish</h2>
  </div>
  <div class="services-grid">
    <div class="service-card"><h3>Interior Painting</h3><p>Walls, ceilings, and trim — proper prep and clean edges, every time.</p></div>
    <div class="service-card"><h3>Exterior Painting</h3><p>Weather-resistant finishes that hold up through every season.</p></div>
    <div class="service-card"><h3>Commercial Projects</h3><p>Office and retail repaints scheduled around your business hours.</p></div>
  </div>
</section>

<footer><p>BRIGHT LINE PAINTING — Residential and commercial painting, done on schedule.</p></footer>

<a href="https://wa.me/27727367095?text=Hi%2C%20I%27d%20like%20to%20chat%20about%20painting" class="wa-float" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <svg viewBox="0 0 24 24" width="30" height="30" fill="white"><path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7C17.18 3.03 14.68 2 12.04 2zm5.8 14.16c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.8-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.79-4.16-4.94-4.35-.14-.2-1.18-1.57-1.18-3 0-1.42.75-2.12 1.01-2.41.27-.29.58-.36.78-.36l.56.01c.18 0 .42-.07.65.5.24.58.82 2 .89 2.15.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.17-.3.37-.43.5-.14.14-.29.29-.13.57.17.28.75 1.24 1.61 2 1.11.99 2.04 1.3 2.32 1.44.28.14.45.12.61-.07.17-.19.72-.84.91-1.13.19-.28.38-.24.64-.14.26.1 1.66.78 1.94.93.28.14.47.21.54.33.07.12.07.68-.17 1.36z"/></svg>
</a>

<script>
  let rate = 2200;
  const roomRange = document.getElementById('roomRange');
  const roomVal = document.getElementById('roomVal');
  const outPrice = document.getElementById('outPrice');
  const outTime = document.getElementById('outTime');
  const jobButtons = document.querySelectorAll('[data-rate]');
  function fmt(n){ return 'R' + Math.round(n).toLocaleString('en-ZA'); }
  function update(){
    const rooms = parseInt(roomRange.value, 10);
    roomVal.textContent = rooms + (rooms === 1 ? ' room' : ' rooms');
    const low = rooms * rate;
    const high = low * 1.2;
    outPrice.textContent = fmt(low) + ' - ' + fmt(high);
    outTime.textContent = rooms <= 3 ? '1 - 2 days' : rooms <= 7 ? '2 - 4 days' : '4 - 7 days';
  }
  roomRange.addEventListener('input', update);
  jobButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      jobButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      rate = parseFloat(btn.dataset.rate);
      update();
    });
  });
  update();
</script>

</body>
</html>
